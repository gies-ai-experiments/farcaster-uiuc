FROM node:20-alpine

WORKDIR /app

# Install git and build dependencies
RUN apk add --no-cache git python3 make g++

# Copy the entire hub-monorepo directory
COPY hub-monorepo/ ./

# Verify files are copied and show directory structure
RUN ls -la && echo "--- Packages directory ---" && ls -la packages/

# Install root dependencies
RUN npm install --legacy-peer-deps

# Build core package
WORKDIR /app/packages/core
RUN npm run build

# Build hub-nodejs package
WORKDIR /app/packages/hub-nodejs
RUN npm run build

# Build and setup shuttle
WORKDIR /app/packages/shuttle
RUN npm run build

# Install tsx globally for running TypeScript
RUN npm install -g tsx

# Run multiple shuttle processes: worker for backfill processing, backfill to queue jobs, and start for main sync
CMD ["sh", "-c", "tsx src/example-app/app.ts worker & tsx src/example-app/app.ts backfill & tsx src/example-app/app.ts start & wait"] 