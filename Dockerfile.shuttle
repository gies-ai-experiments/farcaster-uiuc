# Use a multi-stage build for the shuttle
FROM node:20-alpine AS builder

# Install dependencies for building
RUN apk add --no-cache git python3 make g++

# Copy the hub-monorepo source
COPY hub-monorepo /app

# Set working directory
WORKDIR /app

# Install dependencies and build packages in correct order
RUN npm install

# Build core package first
WORKDIR /app/packages/core
RUN npm run build

# Build hub-nodejs package  
WORKDIR /app/packages/hub-nodejs
RUN npm run build

# Build shuttle package
WORKDIR /app/packages/shuttle
RUN npm run build

# Production stage
FROM node:20-alpine

# Install tsx for TypeScript execution
RUN npm install -g tsx

# Copy built application
COPY --from=builder /app /app

# Set working directory to shuttle
WORKDIR /app/packages/shuttle

# Start with the new full-sync command that does backfill then real-time sync
CMD ["tsx", "src/example-app/app.ts", "full-sync"] 