FROM node:20-alpine

WORKDIR /app

# Install git and build dependencies
RUN apk add --no-cache git python3 make g++

# Copy the entire hub-monorepo directory
COPY hub-monorepo/ ./

# Verify files are copied and show directory structure
RUN ls -la && echo "--- Packages directory ---" && ls -la packages/

# Install root dependencies
RUN npm install --legacy-peer-deps

# Build packages in dependency order
WORKDIR /app/packages/core
RUN npm install && npm run build

# Build hub-nodejs package (depends on core)
WORKDIR /app/packages/hub-nodejs
RUN npm install && npm run build

# Build shuttle package (depends on hub-nodejs and core)
WORKDIR /app/packages/shuttle
RUN npm install && npm run build

# Install tsx globally for running TypeScript
RUN npm install -g tsx

# Start with just the main shuttle process to avoid database connection race conditions
CMD ["tsx", "src/example-app/app.ts", "start"] 