FROM node:20-alpine

WORKDIR /app

# Install git and build dependencies
RUN apk add --no-cache git python3 make g++

# Copy package.json and other root files first
COPY hub-monorepo/package.json /app/package.json
COPY hub-monorepo/package-lock.json /app/package-lock.json
COPY hub-monorepo/tsconfig.json /app/tsconfig.json
COPY hub-monorepo/turbo.json /app/turbo.json

# Copy the packages directory
COPY hub-monorepo/packages/ /app/packages/

# Copy other necessary files
COPY hub-monorepo/.yarnrc /app/.yarnrc
COPY hub-monorepo/biome.json /app/biome.json

# Verify package.json exists and show directory structure
RUN ls -la /app/ && cat /app/package.json

# Install root dependencies
RUN npm install --legacy-peer-deps

# Build core package
WORKDIR /app/packages/core
RUN npm run build

# Build hub-nodejs package
WORKDIR /app/packages/hub-nodejs
RUN npm run build

# Build and setup shuttle
WORKDIR /app/packages/shuttle
RUN npm run build

# Install tsx globally for running TypeScript
RUN npm install -g tsx

# Run multiple shuttle processes: worker for backfill processing, backfill to queue jobs, and start for main sync
CMD ["sh", "-c", "cd /app/packages/shuttle && tsx src/example-app/app.ts worker & tsx src/example-app/app.ts backfill & tsx src/example-app/app.ts start & wait"] 